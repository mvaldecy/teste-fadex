# Copie para `backend/.env` em desenvolvimento local.
# Nao commite `backend/.env`.
#
# Spring Boot nao carrega este arquivo automaticamente.
# Para usar no terminal:
# set -a
# source backend/.env
# set +a
# cd backend && ./gradlew bootRun

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/fadex_helpdesk
DB_USERNAME=fadex
DB_PASSWORD=fadex

JPA_SHOW_SQL=false

JWT_SECRET=trocar-por-valor-local-com-pelo-menos-32-caracteres
JWT_EXPIRATION_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

AI_TRIAGE_ENABLED=false
AI_TRIAGE_BASE_URL=http://localhost:8000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@fadex.local

# Variaveis da stack de PRODUCAO (`docker-compose.prod.yml`).
#
#   cp .env.producao.example .env.producao
#   # edite os cinco valores obrigatorios abaixo
#   docker compose -f docker-compose.prod.yml --env-file .env.producao up -d --build
#
# `.env.producao` esta no .gitignore. Nunca versione o arquivo preenchido.
#
# As cinco variaveis marcadas OBRIGATORIA usam `${VAR:?}` no compose: sem valor, o
# `docker compose` aborta com a mensagem de erro antes de subir qualquer container.
# Um `docker compose -f docker-compose.prod.yml config` que falha por falta delas nao e defeito,
# e a guarda funcionando.

# --- OBRIGATORIAS -----------------------------------------------------------------------------

# Segredo de assinatura dos JWT. Minimo 32 caracteres.
# O default do codigo (`application.properties`) e um texto publico versionado: com ele qualquer
# pessoa assina um token valido e se passa por ADMIN. Gere o seu:
#   openssl rand -base64 48
JWT_SECRET=

# Senha do Postgres. Nao reaproveite a senha `fadex` do ambiente local.
POSTGRES_PASSWORD=

# Origens aceitas pelo CORS. Dominio real do frontend, com esquema, sem barra final.
# Varias origens separadas por virgula. Errar aqui derruba TODA chamada da aplicacao no navegador.
CORS_ALLOWED_ORIGINS=https://helpdesk.exemplo.com.br

# URL publica do frontend, usada como base dos links dentro dos e-mails de notificacao.
# Variavel SEPARADA de CORS_ALLOWED_ORIGINS. Esquecer esta faz o sistema funcionar normalmente e os
# e-mails apontarem para localhost.
FRONTEND_BASE_URL=https://helpdesk.exemplo.com.br

# URL publica da API, com o sufixo /api/v1.
# ATENCAO: entra na imagem do frontend em TEMPO DE BUILD (o Next.js substitui NEXT_PUBLIC_* no
# bundle durante `npm run build`). Mudar este valor depois EXIGE reconstruir a imagem:
#   docker compose -f docker-compose.prod.yml --env-file .env.producao up -d --build frontend
NEXT_PUBLIC_API_BASE_URL=https://api.helpdesk.exemplo.com.br/api/v1

# --- Banco ------------------------------------------------------------------------------------
POSTGRES_DB=fadex_helpdesk
POSTGRES_USER=fadex
# Preencha apenas se usar Postgres gerenciado, fora do compose. Formato JDBC.
# Exige `sslmode=require` na maioria dos provedores. Se preencher, remova o servico `postgres`
# do compose ou simplesmente ignore-o.
# DB_URL=jdbc:postgresql://host-gerenciado:5432/fadex_helpdesk?sslmode=require

# Escape para Postgres SEM a extensao pgvector (provedor gerenciado que nao a oferece).
# Sobrescreve os tres placeholders do Flyway: a extensao vira no-op, a coluna `tickets.embedding`
# vira `text` e o indice HNSW deixa de ser criado.
# SO E VALIDO COM AI_TRIAGE_ENABLED=false — com a IA ligada a gravacao do embedding faz
# `cast(? as vector)` e falha. Validado localmente contra postgres:17-alpine.
# SPRING_APPLICATION_JSON={"spring.flyway.placeholders.pgvector-extension":"select 1","spring.flyway.placeholders.ticket-embedding-column-type":"text","spring.flyway.placeholders.ticket-embedding-index":"select 1"}

# --- Aplicacao --------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=fadex-helpdesk-prod
SPRING_PROFILES_ACTIVE=prod
# Fuso do container do backend. Host em nuvem roda em UTC; sem esta variavel os carimbos aparecem
# tres horas adiantados na tela, porque as entidades usam LocalDateTime.
TZ=America/Fortaleza
NEXT_PUBLIC_APP_NAME=Fadex Helpdesk

# Portas publicadas no host. Atras de um proxy reverso na mesma maquina, prefira publicar so no
# loopback: BACKEND_BIND_ADDRESS=127.0.0.1 e FRONTEND_BIND_ADDRESS=127.0.0.1.
BACKEND_PORT=8080
FRONTEND_PORT=3000
BACKEND_BIND_ADDRESS=0.0.0.0
FRONTEND_BIND_ADDRESS=0.0.0.0

JWT_EXPIRATION_SECONDS=3600
REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# --- Dados de demonstracao --------------------------------------------------------------------
# Ligado de proposito: esta e uma instancia de demonstracao e sem seed a tela de login sobe sem
# nenhuma credencial valida. O preco: as credenciais do README funcionam na URL publica, entao
# qualquer pessoa que a receba entra como ADMIN. Em um sistema real isto seria `false`, com o
# primeiro administrador criado por migration ou comando administrativo.
APP_SEED_ENABLED=true

# --- E-mail -----------------------------------------------------------------------------------
# Nao ha Mailpit em producao. Sem SMTP real, todo envio de notificacao por e-mail falha — a falha e
# registrada em log e nao derruba o fluxo do chamado (timeouts limitados a 5s).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
MAIL_FROM=no-reply@exemplo.com.br

# --- Notificacoes em tempo real (SSE) ---------------------------------------------------------
# Proxies reversos costumam cortar conexoes ociosas antes de 30 min. O heartbeat de 20s segura a
# conexao; se o seu proxy tiver timeout menor, reduza SSE_TIMEOUT_MS de acordo.
SSE_TIMEOUT_MS=1800000
SSE_HEARTBEAT_INTERVAL_MS=20000
SSE_RECONNECT_TIME_MS=5000

# --- IA ---------------------------------------------------------------------------------------
# DESLIGADA por padrao em producao. Com false:
#   - a classificacao continua funcionando, pelo FallbackTicketClassifier (palavras-chave);
#   - a deteccao de duplicados NAO acontece — depende de embeddings, que dependem do Ollama;
#   - cada chamado deixa um job de EMBEDDING falho em GET /api/v1/ai/jobs.
# Para ligar: AI_TRIAGE_ENABLED=true e subir com `--profile ia`, num host com RAM suficiente.
# Ver `docs/infraestrutura/2026-08-15-deploy.md` para os numeros.
AI_TRIAGE_ENABLED=false
AI_BASE_URL=http://ollama:11434
AI_CLASSIFICATION_MODEL=llama3.2:3b
AI_EMBEDDING_MODEL=all-minilm
AI_EMBEDDING_DIMENSIONS=384
AI_WORKER_ENABLED=true
AI_WORKER_BATCH_SIZE=1
AI_WORKER_MAX_ATTEMPTS=3
AI_WORKER_INTERVAL_MILLIS=10000
# Em CPU uma classificacao curta com llama3.2:3b levou 12s em 12 vCPU. Em maquina menor, aumente.
AI_REQUEST_TIMEOUT_SECONDS=20
AI_SIMILARITY_THRESHOLD=0.80
AI_SIMILARITY_LIMIT=3

# --- Infra ------------------------------------------------------------------------------------
QUARTZ_THREAD_COUNT=1
# Sem limite explicito a JVM assume 25% da RAM do host em maquinas pequenas.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

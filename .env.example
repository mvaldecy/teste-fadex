# Variaveis usadas pela infraestrutura local do monorepo.
# Copie para `.env` na raiz antes de subir o Docker Compose: `cp .env.example .env`.
#
# Os valores abaixo sao os mesmos defaults do `docker-compose.yml` e do
# `backend/src/main/resources/application.properties`. Copiar este arquivo sem editar nada da um
# ambiente local funcional — a unica variavel que voce PRECISA trocar e a JWT_SECRET.
#
# Este arquivo e do ambiente de DESENVOLVIMENTO. Para producao use `.env.producao.example` com o
# `docker-compose.prod.yml` — veja `docs/infraestrutura/2026-08-15-deploy.md`.
#
# Duas variaveis daqui nao chegam ao container do backend pelo `docker-compose.yml`, e so valem
# quando o backend roda direto pelo Gradle (`make backend-run`): AI_BASE_URL, que no Compose e
# fixada em `http://ollama:11434`, e SERVER_PORT, fixada em 8080. As demais variaveis de
# configuracao do backend sao repassadas no bloco `environment` do servico `backend`; as que
# nomeiam portas de outros servicos (POSTGRES_PORT, MAILPIT_*, OLLAMA_PORT, FRONTEND_PORT,
# BACKEND_PORT), as NEXT_PUBLIC_* e COMPOSE_PROJECT_NAME sao lidas pelo Compose, nao pelo backend.

# --- Banco ---
POSTGRES_DB=fadex_helpdesk
POSTGRES_USER=fadex
POSTGRES_PASSWORD=fadex
POSTGRES_PORT=5432

# Fuso do container do backend. Sem ele o Docker roda em UTC e as datas aparecem adiantadas.
TZ=America/Fortaleza

# --- Portas e identidade da aplicacao ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_NAME=Fadex Helpdesk
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_BASE_URL=http://localhost:3000

# --- Seguranca ---
# TROQUE ESTE VALOR. Precisa de no minimo 32 caracteres; o default do codigo e um texto de aviso,
# nao um segredo. Gere o seu com:
#   openssl rand -base64 48
JWT_SECRET=trocar-por-valor-local-com-pelo-menos-32-caracteres
JWT_EXPIRATION_SECONDS=3600
REFRESH_TOKEN_EXPIRATION_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- E-mail (Mailpit local) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@fadex.local

# --- Notificacoes em tempo real (SSE) ---
SSE_TIMEOUT_MS=1800000
SSE_HEARTBEAT_INTERVAL_MS=20000
SSE_RECONNECT_TIME_MS=5000

# --- IA ---
# Nasce ligada: a triagem automatica e o nucleo do projeto, e subir com ela desligada faz o sistema
# parecer que nao classifica nada. Desligue apenas se nao quiser rodar o Ollama localmente — o
# classificador de fallback por palavras-chave assume no lugar.
AI_TRIAGE_ENABLED=true
AI_BASE_URL=http://localhost:11434
AI_CLASSIFICATION_MODEL=llama3.2:3b
AI_EMBEDDING_MODEL=all-minilm
AI_EMBEDDING_DIMENSIONS=384
AI_WORKER_ENABLED=true
AI_WORKER_BATCH_SIZE=5
AI_WORKER_MAX_ATTEMPTS=3
AI_REQUEST_TIMEOUT_SECONDS=20
AI_WORKER_INTERVAL_MILLIS=5000
# Limiar de duplicidade: cosseno alto porque falso positivo vira vinculo persistido que alguem tem
# que desfazer. Alinhado ao default do codigo — nao baixe sem medir.
AI_SIMILARITY_THRESHOLD=0.75
AI_SIMILARITY_LIMIT=3

# --- Dados de desenvolvimento ---
APP_SEED_ENABLED=true

# --- Infra ---
QUARTZ_THREAD_COUNT=1
OLLAMA_PORT=11434
COMPOSE_PROJECT_NAME=fadex-helpdesk

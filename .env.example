# Variaveis usadas pela infraestrutura local do monorepo.
# Copie para `.env` na raiz quando o Docker Compose for configurado.

POSTGRES_DB=fadex_helpdesk
POSTGRES_USER=fadex
POSTGRES_PASSWORD=fadex
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_NAME=Fadex Helpdesk
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@fadex.local

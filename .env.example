# Variaveis usadas pela infraestrutura local do monorepo.
# Copie para `.env` na raiz quando o Docker Compose for configurado.

POSTGRES_DB=fadex_helpdesk
POSTGRES_USER=fadex
POSTGRES_PASSWORD=fadex
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_NAME=Fadex Helpdesk
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@fadex.local

AI_TRIAGE_ENABLED=false
AI_BASE_URL=http://localhost:11434
AI_CLASSIFICATION_MODEL=llama3.2:1b
AI_EMBEDDING_MODEL=all-minilm
AI_EMBEDDING_DIMENSIONS=384
AI_WORKER_ENABLED=true
AI_WORKER_BATCH_SIZE=1
AI_WORKER_MAX_ATTEMPTS=3
AI_REQUEST_TIMEOUT_SECONDS=20
AI_WORKER_INTERVAL_MILLIS=10000
AI_SIMILARITY_THRESHOLD=0.75
AI_SIMILARITY_LIMIT=5
QUARTZ_THREAD_COUNT=1
OLLAMA_PORT=11434
COMPOSE_PROJECT_NAME=fadex-helpdesk
